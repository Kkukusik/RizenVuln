# Application
APP_NAME=RizenVuln
APP_ENV=development
RUST_LOG=info
APP_HOST=0.0.0.0
APP_PORT=8080
HTTP_PORT=8080
HTTP_BIND=127.0.0.1
PUBLIC_BASE_URL=http://localhost:8080
# PostgreSQL
POSTGRES_DB=rizenvuln
POSTGRES_USER=rizenvuln
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=
# Harbor
HARBOR_ENABLED=false
HARBOR_URL=
HARBOR_USERNAME=
HARBOR_PASSWORD=
HARBOR_CA_FILE=
# GitHub
GITHUB_ENABLED=true
GITHUB_TOKEN=
GHCR_USERNAME=
# Docker Hub
DOCKERHUB_ENABLED=true
DOCKERHUB_USERNAME=
DOCKERHUB_TOKEN=
# S3
S3_ENABLED=false
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=rizenvuln
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true
S3_CA_FILE=
# Optional S3 hostname resolution
S3_HOSTNAME=
S3_HOST_IP=
# Telegram
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Scanning
SCAN_ENABLED=true
SCAN_INTERVAL_HOURS=24
MAX_CONCURRENT_SCANS=1
TRIVY_CACHE_DIR=/var/cache/trivy
SCAN_TMP_DIR=/tmp/rizenvuln
MAX_IMAGE_BYTES=1073741824
SCAN_ARCHITECTURE=amd64
SCAN_REGISTRY_ALLOWLIST=registry-1.docker.io,ghcr.io
INTELLIGENCE_ENABLED=true
# Updates
UPDATE_CHECK_INTERVAL_MINUTES=30
# Docker discovery: TLS mTLS only, no socket
DOCKER_DISCOVERY_ENABLED=false
DOCKER_HOST=
DOCKER_CA_FILE=
DOCKER_IDENTITY_FILE=
DISCOVERY_ENVIRONMENT=unknown
# Kubernetes: explicit read-only token and CA
KUBERNETES_ENABLED=false
KUBERNETES_URL=
KUBERNETES_TOKEN=
KUBERNETES_CA_FILE=
# Auth
ADMIN_EMAIL=
ADMIN_PASSWORD=
SESSION_SECRET=
METRICS_TOKEN=
